{
  "name": "ludux",
  "productName": "Ludux",
  "description": "Mémoire vidéoludique locale pour réunir bibliothèques, temps de jeu et souvenirs.",
  "author": "Akamasu",
  "license": "UNLICENSED",
  "private": true,
  "version": "0.32.0",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "check": "npm run typecheck && npm run lint && npm test && npm run smoke:electron-sqlite && npm run smoke:electron-preload && npm run smoke:electron-updater && npm run smoke:electron-migrations && npm run smoke:electron-gog && npm run smoke:electron-platforms && npx prisma validate",
    "lint": "oxlint .",
    "postinstall": "prisma generate && electron-builder install-app-deps",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "preview": "electron-vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "smoke:electron-preload": "npm run build && electron scripts/verify-electron-preload.cjs",
    "smoke:electron-updater": "npm run build && electron scripts/verify-electron-updater.cjs",
    "smoke:electron-migrations": "electron scripts/verify-electron-migrations.cjs",
    "smoke:electron-gog": "electron scripts/verify-electron-gog.cjs",
    "smoke:electron-platforms": "npm run build && electron scripts/verify-electron-platform-detection.cjs",
    "smoke:electron-sqlite": "electron scripts/verify-electron-sqlite.cjs",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "build": {
    "appId": "com.akamasu.ludux",
    "productName": "Ludux",
    "artifactName": "Ludux-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Akamasu",
      "repo": "Ludux",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/ludux-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Ludux",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.24.0",
    "oxlint": "^1.71.0",
    "prisma": "^7.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
