# Development database used by Prisma CLI commands.
# The Electron application stores public-version data in the Windows user profile.
DATABASE_URL="file:./userdata/database/ludux.db"

# Steam sync, available since v0.19.0
# Get a user Web API key from https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=""
STEAM_ID_64=""

# Steam local files fallback, available since v0.23.1
# Optional overrides only. Ludux auto-detects Steam paths when possible.
# Libraries are separated with semicolons on Windows.
LUDUX_STEAM_ROOT_PATH=""
LUDUX_STEAM_LIBRARY_PATHS=""

# Epic local files fallback, available since v0.24.20
# Optional overrides only. Ludux auto-detects Epic manifests and launcher cache when possible.
LUDUX_EPIC_MANIFEST_PATHS=""
LUDUX_EPIC_MANAGED_APP_PATHS=""
LUDUX_EPIC_WEBCACHE_PATHS=""

# GOG local files fallback, available since v0.24.22
# Optional overrides only. Ludux auto-detects common GOG install paths when possible.
LUDUX_GOG_LIBRARY_PATHS=""
LUDUX_GOG_GALAXY_DB_PATH=""

# Steam achievements sync, available since v0.24.2
# Limits API calls on large libraries. Installed and most-played games are synced first.
LUDUX_STEAM_ACHIEVEMENT_SYNC_LIMIT="80"

# Automatic sync, available since v0.21.0
# Minimum accepted value: 15 minutes. Default: 120 minutes.
LUDUX_AUTO_SYNC_INTERVAL_MINUTES="120"

# RAWG metadata enrichment, available since v0.23.0
# Get a key from https://rawg.io/apidocs
RAWG_API_KEY=""

# IGDB metadata enrichment, available since v0.24.23
# Create a Twitch developer app with Client Type "Confidential".
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Partner or restricted platforms planned later
XBOX_CLIENT_ID=""
XBOX_CLIENT_SECRET=""
PLAYSTATION_CLIENT_ID=""
PLAYSTATION_CLIENT_SECRET=""
NINTENDO_CLIENT_ID=""
NINTENDO_CLIENT_SECRET=""
GOG_CLIENT_ID=""
GOG_CLIENT_SECRET=""
EPIC_CLIENT_ID=""
EPIC_CLIENT_SECRET=""
